# ---- Server ----
PORT=3000
HOST=0.0.0.0

# ---- Auth: one key per website, format name:key (comma separated). Use long random keys (letters/digits only).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=site1:CHANGE_ME_1,site2:CHANGE_ME_2

# Optional per-client page scopes (JSON). When set, EVERY API_KEYS name must have an array entry.
# Preferred entries are bare Facebook usernames and explicit Instagram prefixes:
#   facebook username → cache key "cern"
#   instagram:nasa    → cache key "instagram:nasa"
# Legacy Facebook/Instagram profile URLs are still accepted in this trusted config only.
# Public HTTP requests must use bare usernames (never URLs).
# Wildcards are rejected. Empty/absent = unscoped (backward compatible).
# Example: API_KEY_PAGE_SCOPES={"site1":["cern","instagram:nasa"]}
API_KEY_PAGE_SCOPES=

# Optional: restrict which Facebook pages can be requested (protects your upstream credits).
# Bare page usernames (or legacy page URLs). Empty = any public page.
# Applied in addition to API_KEY_PAGE_SCOPES when both are set. Does NOT apply to Instagram.
# Example: ALLOWED_PAGES=cern
ALLOWED_PAGES=

# Optional Instagram global allowlist. Bare usernames (or legacy profile URLs) → keys like instagram:nasa.
# Empty = any public Instagram profile (unless API_KEY_PAGE_SCOPES restricts the client).
# Example: INSTAGRAM_ALLOWED_PROFILES=nasa
INSTAGRAM_ALLOWED_PROFILES=

# Optional: browsers allowed to call the API directly (CORS). Empty = server-to-server only.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=120

# ---- Admin / management (Phase 7C.1) ----
# SQLite management DB (admin users, sessions). Separate from post caches.
MANAGEMENT_DIR=./data/management
# One-time bootstrap secret for first admin (min 16 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# After setup completes, the DB remembers completion even if this env remains set.
BOOTSTRAP_SETUP_TOKEN=
# Comma-separated Origins allowed for browser cookie auth mutations (no wildcards).
# Example: ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:3001,https://dashboard.example.com
ADMIN_ALLOWED_ORIGINS=
# Shared secret between Next.js BFF and API (server-only). Required for dashboard login/setup.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_INTERNAL_SECRET=
# AES-256-GCM key for encrypted Apify tokens AND TOTP MFA secrets in SQLite (base64 of 32 random bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back up separately from MANAGEMENT_DIR — ciphertext is useless without this key.
DATA_ENCRYPTION_KEY=
# Optional SMTP for administrator email verification OTPs (not required for self-host).
# When unset, email can still be stored as login identity but is never marked verified.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# Trust X-Forwarded-For / X-Real-IP only behind a known reverse proxy (1 = yes).
TRUST_PROXY=0
# Force Secure cookies: 1=always, 0=never, empty=auto (Secure in NODE_ENV=production).
ADMIN_COOKIE_SECURE=

# ---- Cache ----
CACHE_DIR=./data/cache
# How long cached posts are considered fresh (seconds). Default 6h. After this, cached posts are still
# served instantly while a refresh runs in the background.
FRESH_TTL_SECONDS=21600
# After a failed refresh, wait this long before trying upstream again for the same page.
RETRY_COOLDOWN_SECONDS=300
MAX_POSTS=10

# ---- Providers (tried in this order; a provider is skipped if it is not configured for the page) ----
PROVIDERS=graph,apify
UPSTREAM_RETRIES=2
RETRY_BACKOFF_MS=2000

# Apify — ONE token shared by Facebook + Instagram Actors
APIFY_TOKEN=
APIFY_ACTOR=apify~facebook-posts-scraper
# Input sent to the Facebook actor. "{{PAGE_URL}}" and "{{LIMIT}}" are replaced automatically.
APIFY_INPUT='{"startUrls":[{"url":"{{PAGE_URL}}"}],"resultsLimit":"{{LIMIT}}"}'
APIFY_TIMEOUT_MS=150000
# Max outbound Apify run-sync attempts per UTC day for THIS process across BOTH Actors
# (Facebook posts scraper + Instagram post scraper). Example ops limit, not a USD budget.
# 0 = cache-only (no Apify calls). Failed/timed-out attempts still count. Inspect: npm run quota:status
APIFY_DAILY_RUN_LIMIT=12
# Optional per-run USD cap passed as Apify query param maxTotalChargeUsd (omitted when empty).
APIFY_MAX_CHARGE_USD_PER_RUN=

# Instagram Apify Actor (official: apify/instagram-post-scraper). Reuses APIFY_TOKEN + daily quota.
INSTAGRAM_APIFY_ACTOR=apify~instagram-post-scraper
# Official input fields: username[], resultsLimit, skipPinnedPosts, dataDetailLevel (basicData|detailedData).
# Keep dataDetailLevel=basicData and includeMusicData=false to avoid paid extras.
# Note: basicData Sidecar posts often omit childPosts → carousel children incomplete (cover only).
INSTAGRAM_APIFY_INPUT='{"username":[],"resultsLimit":10,"skipPinnedPosts":true,"dataDetailLevel":"basicData","includeMusicData":false}'
INSTAGRAM_APIFY_TIMEOUT_MS=

# ---- Instagram profile logo (optional; no schema change) ----
# OPTION 1 (recommended for company accounts): verified HTTPS logo map. No extra Actor cost.
# Example: INSTAGRAM_PROFILE_LOGOS={"nasa":"https://cdn.example.com/nasa-official.png"}
INSTAGRAM_PROFILE_LOGOS=
# OPTION 2: optional Apify profile enrichment (DISABLED by default). Separate Actor, SAME shared quota + USD cap.
# Official Actor: apify/instagram-profile-scraper — input usernames[], includeAboutSection=false (paid about section off).
# Never enable in CI. Live enrichment is NOT verified in offline tests.
INSTAGRAM_PROFILE_ENRICHMENT=0
INSTAGRAM_PROFILE_ACTOR=apify~instagram-profile-scraper
INSTAGRAM_PROFILE_TTL_SECONDS=604800
INSTAGRAM_PROFILE_TIMEOUT_MS=60000

# Official Meta Graph API (free, only for Pages you manage). Map page slug/id -> Page access token (JSON).
GRAPH_PAGE_TOKENS=
GRAPH_VERSION=v23.0

# ---- Cache warmer (empty lists = disabled). Same refresh path (quota, cooldown, single-flight).
# Comma-separated Facebook usernames (legacy page URLs also accepted in config).
# Example: WARM_PAGES=cern
WARM_PAGES=
# Comma-separated Instagram usernames (legacy profile URLs also accepted in config).
# Example: INSTAGRAM_WARM_PROFILES=nasa
INSTAGRAM_WARM_PROFILES=
# Seconds between warm cycles. 0 = startup warm only (no periodic refresh).
WARM_INTERVAL_SECONDS=3600
# Max simultaneous warm refreshes (1..8).
WARM_CONCURRENCY=1
# Delay after listen before the first warm cycle.
WARM_STARTUP_DELAY_SECONDS=10

# ---- Isolated acceptance only (never set in production) ----
# Point token verification / Actor calls at a local mock (see docker-compose.browser.yml).
# APIFY_VERIFY_BASE_URL=
# When set, verification uses this base instead of https://api.apify.com.

# ---- Docker Compose + Caddy ----
# Production domain for automatic HTTPS (DNS A/AAAA → server). Example: posts.example.com
# Local overlay uses Caddyfile.local + http://127.0.0.1:8080 (see docker-compose.local.yml).
API_DOMAIN=posts.example.com
# Generate missing secrets safely (does not overwrite existing):
#   npm run secrets:generate
# Local quick start:
#   npm run secrets:generate
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
# Production:
#   Set API_DOMAIN, ADMIN_ALLOWED_ORIGINS=https://your.domain, ADMIN_COOKIE_SECURE=1
#   docker compose up -d --build
# Persist CACHE_DIR + MANAGEMENT_DIR on volume api_data. Run ONE api replica with filesystem quota.
# Dashboard runtime (Compose injects): API_INTERNAL_URL=http://api:3000 and ADMIN_INTERNAL_SECRET.
