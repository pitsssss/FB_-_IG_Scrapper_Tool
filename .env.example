# ---- Server ----
PORT=3000
HOST=0.0.0.0

# ---- Auth: one key per website, format name:key (comma separated). Use long random keys (letters/digits only).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=site1:CHANGE_ME_1,site2:CHANGE_ME_2

# Optional per-client page scopes (JSON). When set, EVERY API_KEYS name must have an array entry.
# Values may mix Facebook page URLs and Instagram profile URLs. Canonical keys:
#   Facebook: parsePageRef() slug OR numeric id (NOT auto-equated)
#   Instagram: instagram:<username> via parseInstagramRef()
# Wildcards are rejected. Empty/absent = unscoped (backward compatible).
# Example: API_KEY_PAGE_SCOPES={"site1":["https://www.facebook.com/cern","https://www.instagram.com/nasa/"]}
API_KEY_PAGE_SCOPES=

# Optional: restrict which Facebook pages can be requested (protects your upstream credits).
# Use the page slug or numeric id, lowercase, comma separated. Empty = any public page.
# Applied in addition to API_KEY_PAGE_SCOPES when both are set. Does NOT apply to Instagram.
ALLOWED_PAGES=

# Optional Instagram global allowlist. Profile URLs or bare usernames → keys like instagram:nasa.
# Empty = any public Instagram profile (unless API_KEY_PAGE_SCOPES restricts the client).
INSTAGRAM_ALLOWED_PROFILES=

# Optional: browsers allowed to call the API directly (CORS). Empty = server-to-server only.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=120

# ---- Cache ----
CACHE_DIR=./data/cache
# How long cached posts are considered fresh (seconds). Default 6h. After this, cached posts are still
# served instantly while a refresh runs in the background.
FRESH_TTL_SECONDS=21600
# After a failed refresh, wait this long before trying upstream again for the same page.
RETRY_COOLDOWN_SECONDS=300
MAX_POSTS=10

# ---- Providers (tried in this order; a provider is skipped if it is not configured for the page) ----
PROVIDERS=graph,apify
UPSTREAM_RETRIES=2
RETRY_BACKOFF_MS=2000

# Apify — ONE token shared by Facebook + Instagram Actors
APIFY_TOKEN=
APIFY_ACTOR=apify~facebook-posts-scraper
# Input sent to the Facebook actor. "{{PAGE_URL}}" and "{{LIMIT}}" are replaced automatically.
APIFY_INPUT='{"startUrls":[{"url":"{{PAGE_URL}}"}],"resultsLimit":"{{LIMIT}}"}'
APIFY_TIMEOUT_MS=150000
# Max outbound Apify run-sync attempts per UTC day for THIS process across BOTH Actors
# (Facebook posts scraper + Instagram post scraper). Example ops limit, not a USD budget.
# 0 = cache-only (no Apify calls). Failed/timed-out attempts still count. Inspect: npm run quota:status
APIFY_DAILY_RUN_LIMIT=12
# Optional per-run USD cap passed as Apify query param maxTotalChargeUsd (omitted when empty).
APIFY_MAX_CHARGE_USD_PER_RUN=

# Instagram Apify Actor (official: apify/instagram-post-scraper). Reuses APIFY_TOKEN + daily quota.
INSTAGRAM_APIFY_ACTOR=apify~instagram-post-scraper
# Official input fields: username[], resultsLimit, skipPinnedPosts, dataDetailLevel (basicData|detailedData).
# Keep dataDetailLevel=basicData and includeMusicData=false to avoid paid extras.
INSTAGRAM_APIFY_INPUT='{"username":[],"resultsLimit":10,"skipPinnedPosts":false,"dataDetailLevel":"basicData","includeMusicData":false}'
INSTAGRAM_APIFY_TIMEOUT_MS=

# Official Meta Graph API (free, only for Pages you manage). Map page slug/id -> Page access token (JSON).
GRAPH_PAGE_TOKENS=
GRAPH_VERSION=v23.0

# ---- Cache warmer (empty lists = disabled). Same refresh path (quota, cooldown, single-flight).
# Comma-separated Facebook page URLs; invalid/unauthorized pages fail startup.
WARM_PAGES=
# Comma-separated Instagram profile URLs (or bare usernames). Empty disables IG warming.
INSTAGRAM_WARM_PROFILES=
# Seconds between warm cycles. 0 = startup warm only (no periodic refresh).
WARM_INTERVAL_SECONDS=3600
# Max simultaneous warm refreshes (1..8).
WARM_CONCURRENCY=1
# Delay after listen before the first warm cycle.
WARM_STARTUP_DELAY_SECONDS=10

# ---- Production (docker-compose + Caddy): your API domain, e.g. api.example.com (DNS A record -> server IP)
API_DOMAIN=api.example.com
# Persist CACHE_DIR (and thus apify-quota.json) on a volume. Run ONE api replica with filesystem quota.
