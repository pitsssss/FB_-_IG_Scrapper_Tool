{
  "name": "fb-posts-api",
  "version": "1.0.0",
  "description": "Facebook page posts API with provider fallback, persistent cache and stable response format",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "start:prod": "node src/index.js",
    "test": "node --test test/api.test.js test/fixture.test.js test/page-identity.test.js test/apify-quota.test.js",
    "capture": "node --env-file=.env scripts/capture-fixture.js",
    "smoke": "node scripts/smoke.js",
    "e2e": "node scripts/e2e-local.js",
    "quota:status": "node --env-file=.env scripts/quota-status.js"
  }
}
