# Server-only. Never prefix secrets with NEXT_PUBLIC_.

# Internal API origin (Node posts + admin API). Never expose to the browser.
API_INTERNAL_URL=http://127.0.0.1:3000

# Must match the API process ADMIN_INTERNAL_SECRET (server-only BFF credential).
ADMIN_INTERNAL_SECRET=

# DATA_ENCRYPTION_KEY lives on the API host only (never required in the dashboard process).

# Optional: force Secure cookies (1/0). Empty = Secure in production.
ADMIN_COOKIE_SECURE=

# Legacy local UI preview flag (obsolete for production gating; auth is required).
# DASHBOARD_DEV_PREVIEW=1
